<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy — Apple Privacy Manifest

  Required for App Store submission as of Spring 2024.
  Declares the app's use of required reason APIs and tracking status.

  See: https://developer.apple.com/documentation/bundleresources/privacy_manifest_files
-->
<plist version="1.0">
<dict>
	<!-- The app does NOT track users across apps/websites -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No tracking domains -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Required Reason API declarations -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults (NSUserDefaults)
		  Reason: CA92.1 — read/write info only accessible to apps in the same
		  App Group. Apple: "access user defaults to read and write information
		  that is only accessible to the apps, app extensions, and App Clips
		  that are members of the same App Group as the app itself."
		  Used by: @capacitor/preferences (linked in
		  ios/App/CapApp-SPM/Package.swift) and Ionic secure storage.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>

		<!--
		  File timestamp APIs (stat/fstat, NSFileCreationDate,
		  NSFileModificationDate, contentModificationDate)
		  Reason: C617.1 — access timestamps/size/metadata of files the user
		  granted access to. Apple: "access the timestamps, size, or other
		  metadata of files or directories that the user specifically granted
		  access to, such as using a document picker view controller."
		  Used by: staff ticket-evidence image reads and the app's cache.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>

		<!--
		  Disk space APIs (NSFileSystemFreeSize, volumeAvailableCapacity...)
		  Reason: 85F4.1 — check there is enough space to write files / delete
		  files when space is low, in a way observable to the user. Apple:
		  "check whether there is sufficient disk space to write files, or to
		  check whether the disk space is low so that the app can delete files
		  when the disk space is low. The app must behave differently based on
		  disk space in a way that is observable to users."
		  Used by: Capacitor/preferences and WebKit cache writes.
		  (NOT E174.1 — that is for showing disk space in an optional bug report
		  the user submits, which this app does not do.)
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>85F4.1</string>
			</array>
		</dict>

		<!--
		  System boot time APIs (systemUptime, mach_absolute_time)
		  Reason: 35F9.1 — calculate absolute timestamps for events that
		  occurred within this app. Apple: "access the system boot time to
		  calculate absolute timestamps for events that occurred within your
		  app [...] System boot time accessed for this reason, or any other
		  information derived from system boot time, may not be sent
		  off-device."
		  Used by: WebKit/JS engine timing inside the app container; no boot
		  time is sent off-device.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>

	<!-- Collected data types declared for App Store Nutrition Label compliance -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCustomerSupport</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>