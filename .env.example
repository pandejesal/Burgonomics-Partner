# Burgonomics Partner Portal — Environment Configuration Example
#
# Two scopes (do not mix):
#   CLIENT (VITE_*): baked into this web bundle at build time.
#   SERVER (no VITE_ prefix): read by Netlify Functions / Cloud Functions at
#   RUNTIME from the hosting dashboard — never copy these into a client .env.

# --- CLIENT (VITE_*) ---
VITE_API_BASE=https://burgonomics.netlify.app
VITE_FIREBASE_API_KEY=AIzaSyAuoa6yU-S8bNR3QDI3DjTUvbKNyBu3_Fs
VITE_FIREBASE_AUTH_DOMAIN=burgonomics-7faa8.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=burgonomics-7faa8
VITE_FIREBASE_STORAGE_BUCKET=burgonomics-7faa8.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=738930066637
VITE_FIREBASE_APP_ID=1:738930066637:web:fc1aa0f0e2a52a19df9584
VITE_PETPOOJA_ENABLED=false
# Optional override for the Cloud Functions Petpooja proxy base.
# Default: https://asia-south1-<VITE_FIREBASE_PROJECT_ID>.cloudfunctions.net/api
# VITE_PETPOOJA_PROXY_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api
# Cloud Functions base override (read by partnerFunctionsApi; project-derived default).
# VITE_FUNCTIONS_API_URL=https://asia-south1-burgonomics-7faa8.cloudfunctions.net/api
# Safety PIN for the admin maintenance-mode lock. NO DEFAULT — the lock refuses
# to engage until this is set (a hardcoded fallback PIN is a universal key).
VITE_ADMIN_MAINTENANCE_PIN=""
# NOTE: VITE_WORKSPACE_ID / VITE_PORTAL_MODE are legacy and read by NO code —
# left unset (kept here so old .env files explain themselves).

# Push Notifications (FCM)
VITE_FCM_ENABLED=false
# Web Push certificate public key (Firebase Console → Project settings → Cloud Messaging)
VITE_FCM_VAPID_KEY=""

# App Check (reCAPTCHA v3 site key). Server enforces only with
# APP_CHECK_ENFORCEMENT=true in functions env (monitor mode by default).
VITE_RECAPTCHA_SITE_KEY=""

# --- SERVER ONLY (Netlify / Functions dashboard, never client .env) ---
# Porter keys below are read by server functions (process.env) — a VITE_*
# copy would LEAK secrets into this public bundle.
PORTER_API_KEY=""
PORTER_CUSTOMER_ID=""
PORTER_CITY="Ahmedabad"
PORTER_WEBHOOK_SECRET=""

# ==============================================================================
# GOING LIVE WITH PETPOOJA (only 3 steps — no code changes)
# 1. Paste the merchant key set from the Petpooja panel into the FUNCTIONS env
#    (Firebase: functions/.env dotenv file — NOT functions:config, which this
#    v2 runtime never reads):
#      PETPOOJA_APP_KEY="..."
#      PETPOOJA_APP_SECRET="..."
#      PETPOOJA_ACCESS_TOKEN="..."
#    (Optional overrides: PETPOOJA_ORDERS_BASE, PETPOOJA_MENU_BASE.)
# 2. Redeploy the Cloud Functions API with those variables set.
# 3. Set VITE_PETPOOJA_ENABLED=true above and redeploy this client.
# Without the flag (default) the app runs fully on the offline mock gateway.
# ==============================================================================

